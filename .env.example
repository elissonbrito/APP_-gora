# Copie para .env.local (não vai para o Git) e ajuste o IP do seu computador.
# Com o backend rodando (cd backend && npm run dev), use:
EXPO_PUBLIC_API_MODE=http
# Celular com Expo Go: IP do computador na rede (veja a mensagem do backend ao iniciar).
# Navegador no mesmo computador: http://localhost:3333
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
# Sem backend, troque para mock e o app usa os dados simulados.
