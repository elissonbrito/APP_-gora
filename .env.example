# Copie para .env.local (não vai para o Git).
# Com o backend rodando (npm run api), use:
EXPO_PUBLIC_API_MODE=http

# Opcional: em desenvolvimento o app descobre sozinho o IP do computador
# (o mesmo que o Expo usa para entregar o app). Defina só para fixar outro
# endereço, ex.: uma API publicada.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3333

# Sem backend, troque para mock e o app usa os dados simulados.
